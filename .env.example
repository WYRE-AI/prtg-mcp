# PRTG API key (Bearer token, generated in the PRTG web UI under Account
# Settings -> My Account -> API Keys). Also the base URL of the PRTG core
# server this connector talks to - PRTG API v2 has no single hosted
# endpoint, every instance is self-hosted or a customer's own PRTG Hosted
# Monitor tenant.
PRTG_API_KEY=
PRTG_BASE_URL=
